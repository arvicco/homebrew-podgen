{
  "//": "dev-loop permission profile: inside the sandbox, full freedom -- the boundary itself is hard. Deny rules use leading * anchored on bin/podgen / a space-prefixed binstub / subcommand start, so wrappers, absolute paths, bash -c and compound commands are covered without matching the repo path; the in-process guard in lib/cli.rb (CLAUDECODE=1) is the second layer. Matrix: .docs/P1-1-permission-matrix.md",
  "permissions": {
    "allow": [
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git status*)",
      "Bash(git blame*)",
      "Bash(git rev-parse*)",
      "Bash(git add*)",
      "Bash(git branch*)",
      "Bash(git push origin phase-*)",
      "Bash(bundle exec rake gate*)",
      "Bash(bundle exec rake test*)",
      "Bash(bundle exec ruby -I*)",
      "Bash(bundle exec ruby test/*)"
    ],
    "deny": [
      "Bash(git push*:*)",
      "Bash(git push*master*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f *)",
      "Bash(git push origin master*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git tag*)",
      "Bash(gh release create*)",
      "Bash(gh pr merge*)",
      "Read(.env)",
      "Read(**/.env)",
      "Bash(bin/podgen publish*)",
      "Bash(bin/podgen unpublish*)",
      "Bash(bin/podgen uploads*)",
      "Bash(bin/podgen tweet*)",
      "Bash(bin/podgen schedule*)",
      "Bash(bin/podgen analytics*)",
      "Bash(brew install*)",
      "Bash(gem install*)",
      "Bash(bundle add*)",
      "Bash(*scripts/run.sh *--publish*)",
      "Bash(*run_uploads.sh*)",
      "Bash(*launchctl start*)",
      "Bash(*launchctl kickstart*)",
      "Bash(*launchctl bootstrap*)",
      "Bash(*launchctl load*)",
      "Bash(*launchctl bootout*)",
      "Bash(*launchctl unload*)",
      "Bash(*git push*master*)",
      "Bash(*git push*--force*)",
      "Bash(*git push* -f *)",
      "Bash(*git tag*)",
      "Bash(*gh release create*)",
      "Bash(*gh pr merge*)",
      "Bash(*bin/podgen *publish*)",
      "Bash(* podgen *publish*)",
      "Bash(podgen *publish*)",
      "Bash(*bin/podgen *uploads*)",
      "Bash(* podgen *uploads*)",
      "Bash(podgen *uploads*)",
      "Bash(*bin/podgen *tweet*)",
      "Bash(* podgen *tweet*)",
      "Bash(podgen *tweet*)",
      "Bash(*bin/podgen *schedule*)",
      "Bash(* podgen *schedule*)",
      "Bash(podgen *schedule*)",
      "Bash(*bin/podgen *analytics*)",
      "Bash(* podgen *analytics*)",
      "Bash(podgen *analytics*)",
      "Bash(*bin/podgen *--youtube*)",
      "Bash(* podgen *--youtube*)",
      "Bash(podgen *--youtube*)",
      "Bash(*bin/podgen *--lingq*)",
      "Bash(* podgen *--lingq*)",
      "Bash(podgen *--lingq*)"
    ]
  },
  "env": {
    "CLAUDE_LIB_GLOB": "lib/**/*.rb",
    "CLAUDE_TEST_GLOB": "test/**/*.rb"
  }
}
